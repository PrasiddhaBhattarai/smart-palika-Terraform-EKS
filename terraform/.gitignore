# Local .terraform directories
# Local .terraform directories
**/.terraform/*

# .tfstate files (should live in remote backend, never committed)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, since they might have sensitive data
# But allow committing the example/dev tfvars since ours has no secrets
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan output files
*.tfplan
tfplan

# Downloaded provider lock file exceptions (keep this committed, don't ignore)
!.terraform.lock.hcl